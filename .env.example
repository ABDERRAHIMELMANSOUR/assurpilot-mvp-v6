# ─────────────────────────────────────────────────────────────────────────────
# AssurPilot — environment variables
#
# Local dev : copy this file to `.env` and fill in real values.
# Vercel    : add each variable under Project Settings → Environment Variables.
#             Never commit a filled-in `.env` — it is git-ignored on purpose.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Pooled connection used by the app at runtime. Serverless functions open a new
# connection per cold start, so this MUST point at a pooler (PgBouncer, Neon
# pooler, Supabase pooler, Prisma Accelerate) or Postgres will run out of slots.
# Add `?pgbouncer=true&connection_limit=1` when the pooler runs in transaction mode.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/assurpilot?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection. Used only by `prisma migrate` / `prisma db push`,
# which cannot run through a transaction pooler. Usually the same database on the
# provider's direct host/port.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/assurpilot?sslmode=require"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
# Required in production — authentication fails without it.
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical URL of the deployment. Vercel infers this automatically on preview
# and production deployments; set it explicitly for local dev and custom domains.
NEXTAUTH_URL="http://localhost:3000"

# ── AZZUR CRM push (optional) ────────────────────────────────────────────────
# Sends each newly recorded call (manual entry, file import) to the AZZUR
# "mise en relation" web service. OFF unless AZZUR_WEBHOOK_ENABLED=true.
# The URL contains a secret key (cle_ws): set it ONLY in Vercel / your local
# .env, never in the repository, and rotate it in AZZUR if it ever leaks.
AZZUR_WEBHOOK_ENABLED="false"
# Full MER URL as shown in AZZUR (Administration > Provenances > "Voir l'URL").
AZZUR_MER_URL="https://www.gestfiches.com/alm-assurances/ws/index.php?ws=mer&id_prov=51&cle_ws=REPLACE_ME"
# Optional overrides:
# AZZUR_MER_ID_PROV="51"            # replaces id_prov in the URL
# AZZUR_MER_PROVENANCE="AE"        # value of the provenance field: the AZZUR provenance CODE (default AE)
# AZZUR_MER_METHOD="GET"            # GET (default, as AZZUR documents) or POST
# AZZUR_MER_RETOUR_WS=""            # json | text: AZZUR's answer format (unset = text, which we parse)
# AZZUR_MER_FORMAT="form"           # form (default) or json (POST only)
# AZZUR_MER_DEFAULTS='{"nom":"Appel Assurpilot","prenom":"reçu par {conseiller}","date_naissance":"01/01/1900","code_postal":"00000"}'
#                                   # stand-ins for data AZZUR requires but a call lacks
# AZZUR_MER_FIELDS='{"telephone":"tel","provenance":"origine","conseiller":"","conseiller_nom":"","date":"date_appel"}'
#                                   # rename a field, or "" to stop sending it
# AZZUR_MER_TIMEOUT_MS="5000"       # per attempt; 2 retries on timeout/5xx/429
# AZZUR_MER_MAX_AGE_HOURS="48"      # older calls are not pushed (no backlog flood)
# AZZUR_MER_ONLY_ANSWERED="false"   # true = skip missed calls
