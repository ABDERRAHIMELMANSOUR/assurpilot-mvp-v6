# ─────────────────────────────────────────────────────────────────────────────
# AssurPilot — environment variables
#
# Local dev : copy this file to `.env` and fill in real values.
# Vercel    : add each variable under Project Settings → Environment Variables.
#             Never commit a filled-in `.env` — it is git-ignored on purpose.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Pooled connection used by the app at runtime. Serverless functions open a new
# connection per cold start, so this MUST point at a pooler (PgBouncer, Neon
# pooler, Supabase pooler, Prisma Accelerate) or Postgres will run out of slots.
# Add `?pgbouncer=true&connection_limit=1` when the pooler runs in transaction mode.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/assurpilot?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection. Used only by `prisma migrate` / `prisma db push`,
# which cannot run through a transaction pooler. Usually the same database on the
# provider's direct host/port.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/assurpilot?sslmode=require"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
# Required in production — authentication fails without it.
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical URL of the deployment. Vercel infers this automatically on preview
# and production deployments; set it explicitly for local dev and custom domains.
NEXTAUTH_URL="http://localhost:3000"
